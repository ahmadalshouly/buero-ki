{
  "expo": {
    "name": "BüroKI",
    "slug": "bueroki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "de.bueroki.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E6B5E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "de.bueroki.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "BüroKI needs your photos to read letters you choose.",
          "cameraPermission": "BüroKI uses the camera to photograph your letters.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0E6B5E",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#121614"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0E6B5E"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "BüroKI uses Face ID to keep your letters private."
        }
      ]
    ],
    "scheme": "bueroki",
    "experiments": {
      "typedRoutes": true
    },
    "userInterfaceStyle": "automatic"
  }
}
